# Relative path to the local SQLite bar store. Create it with `npm run db:init`.
# The database file is gitignored.
DATABASE_PATH=data/bars.sqlite

# Relative directory for future MNQ CSV and Parquet dumps. Contents are gitignored.
RAW_DATA_DIR=data/raw

# Static export prefix. Leave unset for a local `npm run build` and for a GitHub
# user site (<owner>.github.io). For a project site, set this to /<repository-name>
# before building. The Pages workflow sets it from the repository name.
# BASE_PATH=

# Data source is not chosen yet.
# Do not put TradingView session cookies, auth tokens, or other secrets in this
# file, or anywhere else in the repository.
# DATA_SOURCE=
